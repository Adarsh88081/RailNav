<div class="page-header">
  <h1>Station Facilities</h1>
  <p>Search washrooms, food, medical, and more.</p>
</div>

<div class="panel">
  <form action="/facilities" method="GET">
    <div class="inline-form-grid">
      <div class="form-group">
        <label for="station-select">Railway Station</label>
        <select id="station-select" name="station" onchange="this.form.submit()">
          <option value="">Select a station</option>
          <% stations.forEach(function(s) { %>
            <option value="<%= s._id %>" <%= String(s._id) === selectedStation ? 'selected' : '' %>>
              <%= s.name %> (<%= s.code %>)
            </option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="search-input">Search Facility</label>
        <input type="text" id="search-input" name="search" value="<%= search %>" placeholder="e.g. washroom, ATM, food court" <%= selectedStation ? '' : 'disabled' %> />
      </div>
      <div class="form-group">
        <label for="category-select">Category</label>
        <select id="category-select" name="category" <%= selectedStation ? '' : 'disabled' %>>
          <option value="">All categories</option>
          <% ["hygiene","food","medical","finance","assistance","transport","shopping","waiting","security","other"].forEach(function(cat) { %>
            <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" <%= selectedStation ? '' : 'disabled' %>>Search</button>
    </div>
  </form>
</div>

<div class="panel">
  <% if (!selectedStation) { %>
    <div class="empty-state">Select a station to see its facilities.</div>
  <% } else if (facilities.length === 0) { %>
    <div class="empty-state">No facilities found matching your search.</div>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th></th><th>Facility</th><th>Category</th><th>Where</th></tr></thead>
      <tbody>
        <% var icons = {hygiene:"🧴",food:"🍔",medical:"🩺",finance:"💳",assistance:"🧑‍🦽",transport:"🚕",shopping:"📚",waiting:"🛋️",security:"👮",other:"📦"}; %>
        <% facilities.forEach(function(f) { %>
          <tr>
            <td><%= icons[f.category] || "📍" %></td>
            <td><%= f.name %></td>
            <td style="text-transform:capitalize;"><%= f.category %></td>
            <td class="text-muted"><%= f.locationDescription || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
