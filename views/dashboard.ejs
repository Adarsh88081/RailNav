<div class="page-header">
  <h1>Welcome, <%= currentUser.name %></h1>
  <p>Where are you headed today?</p>
</div>

<div class="cards-grid">
  <div class="dash-card">
    <div class="icon">🧭</div>
    <h3>Find Route</h3>
    <p>Get step-by-step navigation to any point inside the station.</p>
    <a href="/route-finder" class="btn btn-navy btn-sm">Start Navigating</a>
  </div>
  <div class="dash-card">
    <div class="icon">🧴</div>
    <h3>Station Facilities</h3>
    <p>Search washrooms, food courts, ATMs, and more.</p>
    <a href="/facilities" class="btn btn-navy btn-sm">Browse Facilities</a>
  </div>
  <div class="dash-card">
    <div class="icon">📝</div>
    <h3>Complaint</h3>
    <p>Report an issue you faced at the station.</p>
    <a href="/complaint" class="btn btn-navy btn-sm">Submit Complaint</a>
  </div>
  <div class="dash-card">
    <div class="icon">💡</div>
    <h3>Suggestions</h3>
    <p>Tell us how RailNav could work better for you.</p>
    <a href="/suggestion" class="btn btn-navy btn-sm">Give Feedback</a>
  </div>
  <div class="dash-card">
    <div class="icon">👤</div>
    <h3>Profile</h3>
    <p>View your searches, complaints, and ratings.</p>
    <a href="/profile" class="btn btn-navy btn-sm">View Profile</a>
  </div>
</div>
