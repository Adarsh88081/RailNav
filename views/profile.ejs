<div class="page-header">
  <h1>My Profile</h1>
  <p>Your details, searches, and complaints.</p>
</div>

<div class="panel">
  <h3><%= currentUser.name %></h3>
  <p class="text-muted"><%= currentUser.email %></p>
  <p class="text-muted">Member since <%= new Date(currentUser.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
</div>

<div class="panel">
  <h3>Previous Searches</h3>
  <% if (!currentUser.previousSearches || currentUser.previousSearches.length === 0) { %>
    <div class="empty-state">No searches yet. Try the route finder!</div>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>Station</th><th>From</th><th>To</th><th>Date</th></tr></thead>
      <tbody>
        <% currentUser.previousSearches.forEach(function(s) { %>
          <tr>
            <td><%= s.station %></td>
            <td><%= s.from %></td>
            <td><%= s.to %></td>
            <td class="text-muted"><%= new Date(s.searchedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="panel">
  <h3>My Complaints</h3>
  <% if (complaints.length === 0) { %>
    <div class="empty-state">No complaints submitted yet.</div>
  <% } else { %>
    <% var badgeClass = { Pending: "badge-pending", "In Progress": "badge-progress", Resolved: "badge-resolved" }; %>
    <table class="data-table">
      <thead><tr><th>Station</th><th>Category</th><th>Description</th><th>Status</th></tr></thead>
      <tbody>
        <% complaints.forEach(function(c) { %>
          <tr>
            <td><%= c.station ? c.station.name : "—" %></td>
            <td style="text-transform:capitalize;"><%= c.category.replace("_", " ") %></td>
            <td class="text-muted"><%= c.description %></td>
            <td><span class="badge <%= badgeClass[c.status] %>"><%= c.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
