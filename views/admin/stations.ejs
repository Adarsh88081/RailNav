<div class="page-header"><h1>Stations</h1><p>Add, edit, or remove stations.</p></div>

<div class="panel">
  <h3>Add Station</h3>
  <form action="/admin/stations" method="POST" class="inline-form-grid">
    <div class="form-group"><label>Name</label><input type="text" name="name" required placeholder="e.g. Howrah" /></div>
    <div class="form-group"><label>Code</label><input type="text" name="code" required placeholder="e.g. HWH" /></div>
    <div class="form-group"><label>City</label><input type="text" name="city" required placeholder="e.g. Kolkata" /></div>
    <button type="submit" class="btn btn-primary">Add Station</button>
  </form>
</div>

<div class="panel">
  <h3>All Stations</h3>
  <% if (stations.length === 0) { %>
    <div class="empty-state">No stations yet.</div>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>Name</th><th>Code</th><th>City</th><th></th></tr></thead>
      <tbody>
        <% stations.forEach(function(s) { %>
          <tr>
            <td><%= s.name %></td>
            <td><%= s.code %></td>
            <td><%= s.city %></td>
            <td>
              <a href="/admin/stations/<%= s._id %>/edit" class="btn btn-navy btn-sm">Edit</a>
              <form action="/admin/stations/<%= s._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this station and all its data?');">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
