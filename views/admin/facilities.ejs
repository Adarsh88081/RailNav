<div class="page-header"><h1>Facilities</h1><p>Manage amenities available at each station.</p></div>

<div class="panel">
  <form action="/admin/facilities" method="GET">
    <div class="form-group">
      <label for="station-select">Select Station</label>
      <select id="station-select" name="station" onchange="this.form.submit()">
        <option value="">Select a station</option>
        <% stations.forEach(function(s) { %>
          <option value="<%= s._id %>" <%= String(s._id) === selectedStation ? 'selected' : '' %>><%= s.name %> (<%= s.code %>)</option>
        <% }) %>
      </select>
    </div>
  </form>
</div>

<% if (selectedStation) { %>
  <div class="panel">
    <h3>Add Facility</h3>
    <form action="/admin/facilities" method="POST" class="inline-form-grid">
      <input type="hidden" name="station" value="<%= selectedStation %>" />
      <div class="form-group"><label>Name</label><input type="text" name="name" required placeholder="e.g. Washroom" /></div>
      <div class="form-group">
        <label>Category</label>
        <select name="category" required>
          <% ["hygiene","food","medical","finance","assistance","transport","shopping","waiting","security","other"].forEach(function(cat) { %>
            <option value="<%= cat %>"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="grid-column: 1 / -1;"><label>Location Description</label><input type="text" name="locationDescription" placeholder="e.g. Near Platform 3" /></div>
      <button type="submit" class="btn btn-primary">Add Facility</button>
    </form>
  </div>

  <div class="panel">
    <h3>Facilities List</h3>
    <% if (facilities.length === 0) { %>
      <div class="empty-state">No facilities added yet.</div>
    <% } else { %>
      <% var icons = {hygiene:"🧴",food:"🍔",medical:"🩺",finance:"💳",assistance:"🧑‍🦽",transport:"🚕",shopping:"📚",waiting:"🛋️",security:"👮",other:"📦"}; %>
      <table class="data-table">
        <thead><tr><th></th><th>Name</th><th>Category</th><th>Where</th><th></th></tr></thead>
        <tbody>
          <% facilities.forEach(function(f) { %>
            <tr>
              <td><%= icons[f.category] || "📍" %></td>
              <td><%= f.name %></td>
              <td style="text-transform:capitalize;"><%= f.category %></td>
              <td class="text-muted"><%= f.locationDescription || "—" %></td>
              <td>
                <form action="/admin/facilities/<%= f._id %>" method="POST" onsubmit="return confirm('Delete this facility?');">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>
