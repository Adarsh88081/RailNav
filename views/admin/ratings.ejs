<div class="page-header"><h1>Ratings</h1><p>Navigation ratings submitted by passengers.</p></div>

<div class="panel">
  <% if (ratings.length === 0) { %>
    <div class="empty-state">No ratings yet.</div>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>User</th><th>Station</th><th>Stars</th><th>Feedback</th></tr></thead>
      <tbody>
        <% ratings.forEach(function(r) { %>
          <tr>
            <td><%= r.user ? r.user.name : "—" %></td>
            <td><%= r.station ? r.station.name : "—" %></td>
            <td><%= "★".repeat(r.stars) + "☆".repeat(5 - r.stars) %></td>
            <td class="text-muted"><%= r.feedback || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
