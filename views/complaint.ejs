<div class="page-header">
  <h1>Submit a Complaint</h1>
  <p>Let us know what went wrong so it can be fixed.</p>
</div>

<div class="panel" style="max-width: 560px;">
  <form action="/complaint" method="POST">
    <div class="form-group">
      <label for="station-select">Station</label>
      <select id="station-select" name="station" required>
        <option value="">Select a station</option>
        <% stations.forEach(function(s) { %>
          <option value="<%= s._id %>"><%= s.name %> (<%= s.code %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="category-select">Category</label>
      <select id="category-select" name="category" required>
        <option value="">Select category</option>
        <option value="cleanliness">Cleanliness</option>
        <option value="safety">Safety</option>
        <option value="staff_behaviour">Staff Behaviour</option>
        <option value="navigation">Navigation</option>
        <option value="facility">Facility</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" required maxlength="1000" placeholder="Describe the issue..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Submit Complaint</button>
  </form>
</div>
